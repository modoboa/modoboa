#, python-format
msgid "Invalid addresses: %s"
msgstr "Endereços inválidos: %s"

#: webmail/serializers.py:413
msgid ""
"original_mailbox, original_mailid and original_action must be provided "
"together"
msgstr "original_mailbox, original_mailid e original_action devem ser informados juntos"

#: webmail/serializers.py:430
#, python-format
msgid ""
"Ensure this field has no more than %(max_length)s characters to schedule the "
"message"
msgstr "Este campo deve ter no máximo %(max_length)s caracteres para agendar a mensagem"

