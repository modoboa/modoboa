#: admin/app_settings.py:20 limits/app_settings.py:38 limits/constants.py:13
msgid "Domains"
msgstr "Domínios"

#: admin/app_settings.py:26
msgid "Enable MX checks"
msgstr "Habilitar verificações MX"

#: admin/app_settings.py:28
msgid "Check that every domain has a valid MX record"
msgstr "Verifique se cada domínio tem um registro MX válido"

#: admin/app_settings.py:35
msgid "Valid MXs"
msgstr "MXs válidos"

#: admin/app_settings.py:38
msgid ""
"A list of IP or network address every MX record should match. A warning will "
"be sent if a record does not respect it."
msgstr ""
"Uma lista de endereços IP ou de rede que cada registro MX deve corresponder. "
"Um aviso será enviado se um registro não for respeitado."

#: admin/app_settings.py:48
msgid "New domains must use authorized MX(s)"
msgstr "Novos domínios devem usar MX(s) autorizado(s)"

#: admin/app_settings.py:52
msgid ""
"Prevent the creation of a new domain if its MX record does not use one of "
"the defined addresses."
msgstr ""
"Impedir a criação de um novo domínio se seu registro MX não usar um dos "
"endereços definidos."

#: admin/app_settings.py:60
msgid "Enable IPV6 checks"
msgstr "Habilitar verificações IPV6"

#: admin/app_settings.py:63
msgid "Check if MX setup for ipv6 is valid"
msgstr "Verifique se a configuração MX para ipv6 é válida"

#: admin/app_settings.py:70
msgid "Enable SPF checks"
msgstr "Habilitar verificações de SPF"

#: admin/app_settings.py:72
msgid "Check if every domain has a valid SPF record"
msgstr "Verifique se cada domínio tem um registro SPF válido"

#: admin/app_settings.py:79
msgid "Enable DKIM checks"
msgstr "Ativar verificações DKIM"

#: admin/app_settings.py:81
msgid "Check if every domain with DKIM signin enabled has a valid DNS record"
msgstr ""
"Verifique se todos os domínios com login DKIM habilitado têm um registro DNS "
"válido"

#: admin/app_settings.py:89
msgid "Enable DMARC checks"
msgstr "Habilitar verificações DMARC"

#: admin/app_settings.py:91
msgid "Check if every domain has a valid DMARC record"
msgstr "Verifique se cada domínio tem um registro DMARC válido"

#: admin/app_settings.py:98
msgid "DMARC check is critical"
msgstr "Verificação de DMARC é crítica"

#: admin/app_settings.py:101
msgid ""
"Consider a missing or invalid DMARC record as critical for the global DNS "
"status of a domain"
msgstr "Considerar um registro DMARC ausente ou inválido como crítico para o estado geral de DNS de um domínio"

#: admin/app_settings.py:109
msgid "Enable autoconfig checks"
msgstr "Habilitar verificações de configuração automática"

#: admin/app_settings.py:111
msgid "Check if every domain has a valid records for autoconfiguration"
msgstr ""
"Verifique se cada domínio tem registros válidos para configuração automática"

#: admin/app_settings.py:119
msgid "Enable DNSBL checks"
msgstr "Ativar verificações DNSBL"

#: admin/app_settings.py:121
msgid "Check every domain against major DNSBL providers"
msgstr ""
"Verifique todos os domínios em relação aos principais provedores de DNSBL"

#: admin/app_settings.py:129
msgid "Notify domain admins about DNS issues"
msgstr "Notificar administradores de domínio sobre problemas de DNS"

#: admin/app_settings.py:132
msgid ""
"Send a notification by email to domain administrators when DNS issues are "
"encountered"
msgstr ""
"Enviar uma notificação por e-mail aos administradores de domínio quando "
"problemas de DNS forem encontrados"

#: admin/app_settings.py:140
msgid "Custom DNS server"
msgstr "Servidor de DNS personalizado"

#: admin/app_settings.py:142
msgid "Use a custom DNS server instead of local server configuration"
msgstr ""
"Usar um servidor DNS personalizado em vez da configuração do servidor local"

#: admin/app_settings.py:150
msgid "DKIM keys storage directory"
msgstr "Diretório de armazenamento de chaves DKIM"

#: admin/app_settings.py:152
msgid ""
"Absolute path of the directory where DKIM private keys will be stored. Make "
"sure this directory belongs to root user and is not readable by the outside "
"world."
msgstr ""
"Caminho absoluto do diretório onde as chaves privadas DKIM serão "
"armazenadas. Certifique-se que este diretório pertença ao usuário root e não "
"seja legível pelo mundo exterior."

#: admin/app_settings.py:161
msgid "Default DKIM key length"
msgstr "Comprimento padrão da chave DKIM"

#: admin/app_settings.py:163
msgid "Default length in bits for newly generated DKIM keys."
msgstr "Comprimento padrão em bits para chaves DKIM recém-geradas."

#: admin/app_settings.py:170
msgid "Default domain quota"
msgstr "Cota de domínio padrão"

#: admin/app_settings.py:172
msgid ""
"Default quota (in MB) applied to freshly created domains with no value "
"specified. A value of 0 means no quota."
msgstr ""
"Cota padrão (em MB) aplicada para domínios recém-criados sem nenhum valor "
"especificado. Um valor 0 significa que não há cota."

#: admin/app_settings.py:180
msgid "Default domain sending limit"
msgstr "Limite padrão de envio de domínio"

#: admin/app_settings.py:183
msgid ""
"Number of messages freshly created domains will be allowed to send per day. "
"Leave empty for no limit."
msgstr ""
"Número de mensagens que os domínios recém-criados poderão enviar por dia. "
"Deixe vazio para ilimitado."

#: admin/app_settings.py:195 limits/app_settings.py:61
#: limits/app_settings.py:135 limits/constants.py:31 limits/constants.py:84
msgid "Mailboxes"
msgstr "Caixas de correio"

#: admin/app_settings.py:201
msgid "Handle mailboxes on filesystem"
msgstr "Manipular caixas de correio no sistema de arquivos"

#: admin/app_settings.py:203
msgid ""
"Rename or remove mailboxes on the filesystem when they get renamed or "
"removed within Modoboa"
msgstr ""
"Renomeie ou remova caixas de correio no sistema de arquivos quando elas "
"forem renomeadas ou removidas no Modoboa"

#: admin/app_settings.py:211 admin/models/domain.py:67
msgid "Default mailbox quota"
msgstr "Cota de caixa de correio padrão"

#: admin/app_settings.py:213
msgid ""
"Default mailbox quota (in MB) applied to freshly created domains with no "
"value specified. A value of 0 means no quota."
msgstr ""
"Cota de caixa de correio padrão (em MB) aplicada para domínios recém-criados "
"sem nenhum valor especificado. Um valor 0 significa que não há cota."

#: admin/app_settings.py:222
msgid "Default mailbox sending limit"
msgstr "Limite padrão de envio de caixa de correio"

#: admin/app_settings.py:225
msgid ""
"Number of messages freshly created mailboxes will be allowed to send per "
"day. Leave empty for no limit."
msgstr ""
"Número de mensagens que caixas de correio recém-criadas poderão enviar por "
"dia. Deixe vazio para ilimitado."

#: admin/app_settings.py:233
msgid "Automatic account removal"
msgstr "Remoção automática de conta"

#: admin/app_settings.py:235
msgid "When a mailbox is removed, also remove the associated account"
msgstr ""
"Quando uma caixa de correio for removida, remova também a conta associada"

#: admin/app_settings.py:244
msgid "Automatic domain/mailbox creation"
msgstr "Criação automática de domínio/caixa de correio"

#: admin/app_settings.py:247
msgid "Create a domain and a mailbox when an account is automatically created."
msgstr ""
"Crie um domínio e uma caixa de correio quando uma conta for criada "
"automaticamente."

#: admin/app_settings.py:256
msgid "Create an alias when a mailbox is renamed"
msgstr "Criar um apelido quando uma caixa de correio for renomeada"

#: admin/app_settings.py:259
msgid "Create an alias using the old address when a mailbox is renamed."
msgstr ""
"Crie um apelido usando o endereço antigo quando uma caixa de correio for "
"renomeada."

#: admin/app_settings.py:271
msgid "Aliases"
msgstr "Apelidos"

#: admin/app_settings.py:277
msgid "Alias can target any domain"
msgstr "Apelido pode apontar para qualquer domínio"

#: admin/app_settings.py:279
msgid "Allow aliases to target any domain, not just the local domains."
msgstr ""
"Permite que apelidos apontem para qualquer domínio, não apenas os domínios "
"locais."

#: admin/app_settings.py:286
msgid "Alias target block list"
msgstr "Lista de bloqueio de destinos de apelido"

#: admin/app_settings.py:288
msgid "A list of domains that aliases cannot target (comma separated)."
msgstr ""
"Uma lista de domínios para os quais os apelidos não podem apontar (separados "
"por vírgula)."

#: admin/app_settings.py:296
msgid "Alias target allow list"
msgstr "Lista de permissão de destinos de apelido"

#: admin/app_settings.py:298
msgid "A list of domains that aliases can target (comma separated)."
msgstr ""
"Uma lista de domínios para os quais os apelidos podem apontar (separados por "
"vírgula)."

